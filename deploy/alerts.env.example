# Copy to .env.ops-alerts locally or /etc/gati/alerts.env on the host, mode 0600.
# Parsed as data: KEY=VALUE, optional matching quotes, full-line comments only.
# No shell expansion, export, interpolation, escapes or inline comments. Never source.
GATI_ALERT_TO=project@example.invalid
GATI_ALERT_FROM=sender@example.invalid
GATI_SMTP_HOST=smtp.example.invalid
GATI_SMTP_PORT=587
# starttls (usually 587) or ssl (usually 465); plaintext is rejected.
GATI_SMTP_TLS=starttls
GATI_SMTP_USERNAME=replace-with-smtp-username
GATI_SMTP_PASSWORD=replace-with-smtp-app-password
